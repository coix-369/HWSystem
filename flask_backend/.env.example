# 配置模板 —— 复制为 flask_backend/.env 后填入你自己的真实值
#   copy flask_backend\.env.example flask_backend\.env
# .env 已被 .gitignore 忽略，真实密钥不会被上传

# --- PostgreSQL ---
DB_NAME=HWSystem
DB_USER=postgres
DB_PASSWORD=你的数据库密码
DB_HOST=localhost
DB_PORT=5432
DEV_DATABASE_URL=postgresql://用户名:密码@localhost/HWSystem?client_encoding=utf8
TEST_DATABASE_URL=postgresql://用户名:密码@localhost/HWSystem_test?client_encoding=utf8
DATABASE_URL=postgresql://用户名:密码@localhost/HWSystem?client_encoding=utf8

# --- Flask ---
# 会话签名密钥，请自行随机生成一串字符
SECRET_KEY=请替换为随机字符串
FLASK_CONFIG=development
REDIS_URL=redis://localhost:6377/0

# --- 和风天气 QWeather（https://dev.qweather.com/ 申请）---
QWEATHER_KEY=你的和风天气API Key
QWEATHER_HOST=你的专属API Host（形如 xxxx.re.qweatherapi.com）

# --- 豆包大模型 / 火山方舟（https://console.volcengine.com/ark 申请）---
DOUBAO_ENABLED=false
DOUBAO_API_KEY=你的方舟API Key
DOUBAO_ENDPOINT_ID=ep-xxxxxxxxxxxx-xxxxx

# --- 初始化脚本创建 admin 用户时使用的默认密码 ---
ADMIN_DEFAULT_PASSWORD=admin123
